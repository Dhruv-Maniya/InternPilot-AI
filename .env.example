# ==============================================================================
# InternPilot AI — Root Environment Variables Template
# Copy this file to app/backend/.env and populate with your credentials.
# ==============================================================================

# SerpApi — Google Jobs internship search API key
# https://serpapi.com/
SERPAPI_API_KEY=

# Google Gemini — Generative AI API key (for Discovery, Aptitude, & Interview Agents)
# https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI — Optional fallback or OpenAI-compatible endpoint
OPENAI_API_KEY=

# Supabase — PostgreSQL Database & Authentication credentials
# https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
